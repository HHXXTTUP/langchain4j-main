page {
  min-height: 100%;
  background: #fff9f3;
  color: #3f3a37;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
scroll-view,
picker {
  box-sizing: border-box;
}

button {
  letter-spacing: 0;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 30rpx 28rpx 56rpx;
}

.page-intro {
  margin: 8rpx 4rpx 24rpx;
}

.eyebrow {
  color: #e56f62;
  font-size: 24rpx;
  font-weight: 700;
}

.page-title {
  margin-top: 8rpx;
  color: #342f2c;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #7c746e;
  font-size: 27rpx;
  line-height: 1.65;
}

.panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #f1e7dd;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(98, 73, 54, 0.07);
}

.section-title {
  color: #403a36;
  font-size: 31rpx;
  font-weight: 800;
}

.section-note {
  margin-top: 6rpx;
  color: #8d847d;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 14rpx;
  background: #e56f62;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1;
}

.primary-button[disabled] {
  background: #d8d1cb;
  color: #ffffff;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border: 2rpx solid #eddbd0;
  border-radius: 12rpx;
  background: #fffaf6;
  color: #665c55;
  font-size: 27rpx;
  font-weight: 700;
}

.button-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
}

.empty-state {
  padding: 50rpx 24rpx;
  text-align: center;
}

.empty-image {
  width: 260rpx;
  height: 195rpx;
  margin-bottom: 18rpx;
}

.empty-title {
  display: block;
  color: #554d47;
  font-size: 29rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin-top: 8rpx;
  color: #91877f;
  font-size: 24rpx;
  line-height: 1.55;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
