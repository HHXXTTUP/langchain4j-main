.plan-page {
  background: #fff9f3;
}

.page-intro text {
  display: block;
}

.view-switcher {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #f4ebe3;
}

.view-tab {
  flex: 1;
  min-height: 70rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 10rpx;
  background: transparent;
  color: #8d8178;
  font-size: 24rpx;
  line-height: 70rpx;
}

.view-tab.active {
  background: #ffffff;
  color: #e56f62;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(110, 80, 55, 0.08);
}

.date-scroll {
  width: 100%;
  margin-bottom: 22rpx;
  white-space: nowrap;
}

.date-list {
  display: inline-flex;
  gap: 12rpx;
}

.date-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid #eee4dc;
  border-radius: 14rpx;
  background: #ffffff;
  color: #887d74;
}

.date-item.active {
  border-color: #e56f62;
  background: #e56f62;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(229, 111, 98, 0.2);
}

.date-weekday {
  font-size: 22rpx;
}

.date-number {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.today-dot {
  position: absolute;
  bottom: 9rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f4bf51;
}

.date-item.active .today-dot {
  background: #fff4c6;
}

.progress-panel {
  margin-bottom: 30rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #4f7066;
  color: #ffffff;
}

.progress-date,
.progress-number,
.progress-message {
  display: block;
}

.progress-date {
  color: #d5e9e1;
  font-size: 24rpx;
}

.progress-number {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 800;
}

.progress-total {
  color: #c6ddd4;
  font-size: 25rpx;
  font-weight: 400;
}

.progress-track,
.record-track {
  height: 14rpx;
  overflow: hidden;
  border-radius: 7rpx;
  background: rgba(255, 255, 255, 0.2);
}

.progress-track {
  margin-top: 18rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 7rpx;
  background: #f6c85f;
}

.progress-message {
  margin-top: 18rpx;
  color: #e3f1ec;
  font-size: 23rpx;
}

.task-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 18rpx;
}

.task-heading text {
  display: block;
}

.round-add {
  width: 70rpx;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #e56f62;
  color: #ffffff;
  font-size: 45rpx;
  line-height: 66rpx;
}

.task-list {
  overflow: hidden;
  border: 2rpx solid #eee3da;
  border-radius: 14rpx;
  background: #ffffff;
}

.task-item {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx 18rpx;
  border-bottom: 2rpx solid #f4ece5;
}

.task-item:last-child {
  border-bottom: none;
}

.check-button {
  flex: none;
  width: 46rpx;
  height: 46rpx;
  margin: 0 14rpx 0 0;
  padding: 0;
  border: 3rpx solid #d5c9bf;
  border-radius: 50%;
  background: #ffffff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.task-item.done .check-button {
  border-color: #73bda8;
  background: #73bda8;
}

.task-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.icon-english { background: #e1f1ed; color: #4f897a; }
.icon-reading { background: #fff0d3; color: #b27b27; }
.icon-sports { background: #fde1dc; color: #cc675d; }
.icon-art { background: #e8e0f5; color: #7e6aa9; }
.icon-other { background: #f4eadc; color: #9a7b5e; }

.task-copy {
  flex: 1;
  min-width: 0;
}

.task-copy text {
  display: block;
}

.task-title {
  overflow: hidden;
  color: #4d4641;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  margin-top: 8rpx;
  color: #a19890;
  font-size: 22rpx;
}

.task-item.done .task-title {
  color: #a7a19c;
  text-decoration: line-through;
}

.delete-button,
.close-button {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  margin: 0 0 0 10rpx;
  padding: 0;
  background: transparent;
  color: #c3b9b1;
  font-size: 38rpx;
  line-height: 48rpx;
}

.course-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-intro text {
  display: block;
}

.generate-button {
  min-height: 62rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 31rpx;
  background: #fff0eb;
  color: #d96b5f;
  font-size: 23rpx;
  line-height: 62rpx;
}

.course-list {
  margin-left: 18rpx;
}

.course-item {
  display: flex;
  align-items: stretch;
  min-height: 116rpx;
}

.course-day {
  width: 74rpx;
  padding-top: 27rpx;
  color: #8d8178;
  font-size: 23rpx;
}

.course-line {
  position: relative;
  width: 28rpx;
  margin: 0 18rpx 0 0;
  border-left: 3rpx solid #e7dbd1;
}

.course-line::before {
  content: '';
  position: absolute;
  top: 30rpx;
  left: -9rpx;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid #fff9f3;
  border-radius: 50%;
  background: #e56f62;
}

.course-card {
  flex: 1;
  align-self: center;
  min-height: 92rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.tone-coral { background: #fff0eb; }
.tone-mint { background: #e8f5f0; }
.tone-yellow { background: #fff5dc; }
.tone-blue { background: #eaf3f6; }
.tone-purple { background: #f0ebf8; }

.course-card text {
  display: block;
}

.course-time,
.course-duration {
  color: #968a81;
  font-size: 21rpx;
}

.course-title {
  margin: 6rpx 0;
  color: #534a44;
  font-size: 27rpx;
  font-weight: 800;
}

.record-summary {
  position: relative;
  overflow: hidden;
  background: #f3e8d8;
}

.record-summary::after {
  content: '✦';
  position: absolute;
  right: 44rpx;
  top: 24rpx;
  color: #e8b64e;
  font-size: 80rpx;
}

.summary-kicker,
.summary-copy {
  display: block;
  color: #8e7765;
}

.summary-kicker { font-size: 23rpx; }
.summary-number { display: block; margin: 8rpx 0; color: #5a493d; font-size: 68rpx; font-weight: 800; }
.summary-copy { font-size: 24rpx; }

.record-heading {
  margin-top: 28rpx;
}

.record-list {
  overflow: hidden;
  border: 2rpx solid #eee3da;
  border-radius: 14rpx;
  background: #ffffff;
}

.record-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 18rpx 22rpx;
  border-bottom: 2rpx solid #f4ece5;
}

.record-item:last-child { border-bottom: none; }

.record-date {
  flex: none;
  width: 132rpx;
}

.record-date text { display: block; }
.record-date text:first-child { color: #5e534b; font-size: 25rpx; font-weight: 700; }
.record-date text:last-child { margin-top: 5rpx; color: #aaa099; font-size: 20rpx; }
.record-track { flex: 1; height: 12rpx; background: #f2e9e2; }
.record-fill { height: 100%; border-radius: 6rpx; background: #73bda8; }
.record-percent { width: 72rpx; color: #7d7168; font-size: 22rpx; text-align: right; }

.modal-layer {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(59, 47, 39, 0.35);
}

.composer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fffdfb;
}

.composer-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.composer-heading text { display: block; }

.task-input {
  width: 100%;
  height: 86rpx;
  padding: 0 22rpx;
  border: 2rpx solid #eadfd6;
  border-radius: 12rpx;
  background: #fffaf6;
  color: #443d39;
  font-size: 27rpx;
  line-height: 86rpx;
}

.composer-row {
  display: flex;
  gap: 14rpx;
  margin: 18rpx 0 26rpx;
}

.composer-picker,
.minutes-input {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 74rpx;
  border: 2rpx solid #eadfd6;
  border-radius: 12rpx;
  background: #fffaf6;
  color: #665c55;
  font-size: 25rpx;
}

.composer-picker { flex: 1; }
.minutes-input { width: 220rpx; }
.minutes-input input { width: 90rpx; text-align: right; }
.minutes-input text { margin-left: 8rpx; color: #9b9189; }
